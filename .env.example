# ==============================================================================
# Environment Configuration for Classroom Seating & Lesson Management System
# Copy this file to `.env` for local Postgres testing, or set in Vercel Dashboard.
# ==============================================================================

# PostgreSQL database connection string (e.g. Neon, Supabase, or local Postgres).
# If omitted during local `npm run dev`, the app automatically uses an in-memory database.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Teacher passcode required to log into the web application.
# Choose something simple and secure for teacher access.
APP_PASSCODE="20252026"

# Secret key used for signing session cookies.
# Generate a secure 32-byte secret using: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-string-in-production"
